> read_xlsx_base <- function(xlsx_file) {
+   tmp <- tempfile()
+   dir.create(tmp)
+   unzip(xlsx_file, exdir = tmp)
+   
+   # Read shared strings if present
+   ss_path <- file.path(tmp, "xl", "sharedStrings.xml")
+   shared_strings <- character(0)
+   if (file.exists(ss_path)) {
+     ss_txt <- paste(readLines(ss_path, warn = FALSE), collapse = "")
+     si_blocks <- regmatches(ss_txt, gregexpr("<si>.*?</si>", ss_txt))[[1]]
+     shared_strings <- sapply(si_blocks, function(b) {
+       t_vals <- regmatches(b, gregexpr("<t[^>]*>.*?</t>", b))[[1]]
+       paste(gsub("<[^>]+>", "", t_vals), collapse = "")
+     }, USE.NAMES = FALSE)
+   }
+   
+   # Read sheet1.xml
+   sheet_path <- file.path(tmp, "xl", "worksheets", "sheet1.xml")
+   sh_txt <- paste(readLines(sheet_path, warn = FALSE), collapse = "")
+   row_blocks <- regmatches(sh_txt, gregexpr("<row[^>]*>.*?</row>", sh_txt))[[1]]
+   
+   col_to_num <- function(ref) {
+     letters_only <- gsub("[0-9]", "", ref)
+     chars <- strsplit(letters_only, "")[[1]]
+     sum((match(chars, LETTERS)) * (26 ^ (rev(seq_along(chars)) - 1)))
+   }
+   
+   parsed_rows <- lapply(row_blocks, function(r) {
+     cells <- regmatches(r, gregexpr("<c [^>]*>.*?</c>|<c [^/]*/>", r))[[1]]
+     vals <- character(0)
+     cols <- integer(0)
+     for (c_xml in cells) {
+       ref <- sub('.*r="([A-Z0-9]+)".*', "\\1", c_xml)
+       c_idx <- col_to_num(ref)
+       
+       if (grepl('t="s"', c_xml)) {
+         v_match <- regmatches(c_xml, regexpr("<v>.*?</v>", c_xml))
+         val <- if (length(v_match) > 0) shared_strings[as.integer(gsub("<[^>]+>", "", v_match)) + 1] else NA_character_
+       } else if (grepl('t="inlineStr"|t="str"', c_xml)) {
+         t_match <- regmatches(c_xml, gregexpr("<t[^>]*>.*?</t>", c_xml))[[1]]
+         val <- if (length(t_match) > 0) paste(gsub("<[^>]+>", "", t_match), collapse = "") else NA_character_
+       } else {
+         v_match <- regmatches(c_xml, regexpr("<v>.*?</v>", c_xml))
+         val <- if (length(v_match) > 0) gsub("<[^>]+>", "", v_match) else NA_character_
+       }
+       cols <- c(cols, c_idx)
+       vals <- c(vals, val)
+     }
+     row_vec <- rep(NA_character_, max(cols))
+     row_vec[cols] <- vals
+     row_vec
+   })
+   
+   max_len <- max(sapply(parsed_rows, length))
+   mat <- do.call(rbind, lapply(parsed_rows, function(x) c(x, rep(NA_character_, max_len - length(x)))))
+   df <- as.data.frame(mat[-1, , drop = FALSE], stringsAsFactors = FALSE)
+   names(df) <- mat[1, ]
+   df
+ }
